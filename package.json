  "scripts": {
    "dev": "vite",
    "dev:server": "cross-env NODE_ENV=development tsx server/index.ts",
    "dev:server:static": "cross-env NODE_ENV=production PORT=5000 tsx server/index.ts",
    "build": "node scripts/platformBuild.mjs",
    "build:client": "vite build --config client/vite.config.ts",
    "build:server": "node scripts/buildServer.mjs",
    "build:platform": "node scripts/platformBuild.mjs",
    "cap:add:android": "npx --yes @capacitor/cli add android",
    "cap:add:ios": "npx --yes @capacitor/cli add ios",
    "cap:sync": "npx --yes @capacitor/cli sync",
    "cap:prepare": "npm run build && npm run cap:sync",
    "cap:open:android": "npx --yes @capacitor/cli open android",
    "cap:open:ios": "npx --yes @capacitor/cli open ios",
    "build:lib": "vite build --config vite.lib.config.ts",
    "doctor": "node scripts/repoDoctor.mjs",
    "start": "node dist/server/index.js",
    "start:local": "cross-env NODE_ENV=production PORT=5000 node dist/server/index.js",
    "check": "tsc",
    "db:generate:sql": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "test:flows:e2e": "playwright test",
    "test:staff-rbac": "npx --yes tsx scripts/testStaffRBAC.ts",
    "test:admin-manual-provisioning": "npx --yes tsx scripts/testAdminManualProvisioning.ts",
    "prep:admin-manual-provisioning": "npx --yes tsx scripts/prepAdminManualProvisioning.ts",
    "test:admin-manual-provisioning:full": "npm run prep:admin-manual-provisioning && npm run test:admin-manual-provisioning",
    "test:deal-contract": "tsx scripts/testDealCreationContract.ts",
    "test:deal-routes": "tsx scripts/testDealCreationRoutes.ts",
    "test:supplier-payments": "tsx scripts/testSupplierPaymentIntentFlow.ts",
    "test:supplier-pay-intent-switch": "tsx scripts/testSupplierPayIntentMethodSwitch.ts",
    "test:ordering-subscription-scope": "tsx scripts/testOrderingSubscriptionScope.ts",
    "ordering:session-cookie": "node -e \"(async()=>{const base=(process.env.SMOKE_BASE_URL||'http://127.0.0.1:5000').replace(/\\/$/,'');const email=process.env.ORDERING_OWNER_EMAIL;const password=process.env.ORDERING_OWNER_PASSWORD;if(!email||!password){console.log('Set ORDERING_OWNER_EMAIL and ORDERING_OWNER_PASSWORD');process.exit(0);}const res=await fetch(base+'/api/auth/login',{method:'POST',headers:{'Content-Type':'application/json','Accept':'application/json'},body:JSON.stringify({email,password})});const body=await res.json().catch(()=>({}));if(!res.ok){console.error('Login failed',res.status,body);process.exit(1);}const cookies=(typeof res.headers.getSetCookie==='function'?res.headers.getSetCookie():(res.headers.get('set-cookie')?[res.headers.get('set-cookie')]:[])).map(v=>String(v||'').split(';')[0]).filter(Boolean).join('; ');console.log(cookies||'No cookie returned');})().catch(e=>{console.error(e);process.exit(1);})\"",
    "smoke:ordering-subscription-access": "node scripts/smokeOrderingSubscriptionAccess.mjs",
    "test:ordering-all": "npm run test:ordering-subscription-scope && npm run smoke:ordering-subscription-access",
    "load:supplier-payments": "tsx scripts/loadSupplierPayments.ts",
    "check:scale-readiness": "tsx scripts/scaleReadinessCheck.ts",
    "check:mobile-readiness": "tsx scripts/mobileReadinessCheck.ts",
    "check:store-readiness": "tsx scripts/storeReadinessCheck.ts",
    "check:release-readiness": "node scripts/releaseReadinessCheck.mjs",
    "smoke:mobile-deeplinks": "tsx scripts/mobileDeepLinkSmoke.ts",
    "smoke:mobile-deeplinks:with-server": "node scripts/mobileDeepLinkSmokeWithServer.mjs",
    "verify:deal-writes": "npx dotenv-cli -e .env -- npx tsx scripts/verifyDealWrites.ts",
    "test:incidents": "npx --yes tsx scripts/testIncidents.ts",
    "checklist:incidents": "node scripts/runIncidentStagingChecklist.mjs",
    "checklist:incidents:strict": "cross-env CHECKLIST_REQUIRE_SMS=true CHECKLIST_REQUIRE_SLACK=true npm run checklist:incidents",
    "checklist:security": "node scripts/runSecurityVerificationChecklist.mjs",
    "checklist:security:prod": "cross-env CHECKLIST_SKIP_RBAC=true npm run checklist:security",
    "checklist:security:strict": "cross-env CHECKLIST_REQUIRE_SMS=true CHECKLIST_REQUIRE_SLACK=true npm run checklist:security",
    "validate:config": "npx --yes tsx scripts/validateConfig.ts",
    "migrate:sql": "tsx scripts/runSqlMigration.ts",
    "backfill:host-coordinates": "tsx scripts/backfillHostGeocodes.ts",
    "backfill:map-coordinates": "tsx scripts/backfillMapCoordinates.ts",
    "backfill:parking-pass-hours": "tsx scripts/backfillParkingPassHours.ts",
    "backfill:parking-pass-series": "tsx scripts/backfillParkingPassSeriesDefaults.ts",
    "backfill:restaurant-subscriptions": "tsx scripts/backfillRestaurantSubscriptions.ts",
    "stress-test": "tsx scripts/stressTest.ts",
    "test:flows": "tsx scripts/userFlows.ts",
    "test:flows:with-server": "node scripts/testFlowsWithServer.mjs",
    "smoke:critical": "node scripts/smokeCriticalRoutes.mjs",
    "gate:prelaunch": "node scripts/preLaunchGate.mjs",
    "smoke:parking-pass-stripe": "tsx scripts/smokeParkingPassStripeFlow.ts",
    "smoke:parking-pass-public-feed": "tsx scripts/smokeParkingPassPublicFeed.ts",
    "test:parking-pass-concurrency": "tsx scripts/testParkingPassBookingConcurrency.ts",
    "audit:parking-pass-webhooks": "tsx scripts/auditParkingPassWebhookReconciliation.ts",
    "test:parking-pass-datekeys": "tsx scripts/testParkingPassDateKeys.ts",
    "audit:demand-funnel": "tsx scripts/auditLocationDemandFunnel.ts",
    "test:parking-pass-webhook-replay": "tsx scripts/testParkingPassWebhookReplay.ts",
    "check:parking-pass-readiness": "tsx scripts/runParkingPassReadinessSuite.ts",
    "audit:location-demand-activation": "tsx scripts/auditLocationDemandActivation.ts",
    "smoke:supply-individual": "tsx scripts/smokeSupplierIndividualBuyerOrder.ts",
    "test:money-button": "tsx scripts/testMoneyButton.ts",
    "test:all": "npm run check && npm run test:flows && npm run stress-test",
    "monitor": "tsx scripts/monitorPerformance.ts",
    "audit:theme": "node scripts/audit-theme-colors.mjs"
  },
