{
  "installCommand": "npm ci",
  "buildCommand": "npm run build:client",
  "outputDirectory": "client/dist",
  "redirects": [
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "mealscout.us" }],
      "destination": "https://www.mealscout.us/$1",
      "permanent": true
    }
  ],
  "routes": [
    {
      "src": "/",
      "has": [{ "type": "query", "key": "prerender" }],
      "dest": "https://mealscout.onrender.com/?prerender=1"
    },
    {
      "src": "/(map|search|video|share-hub|truck-onboarding|restaurant-signup|events|request-truck|for-restaurants|for-hosts|host-location-partner)",
      "has": [{ "type": "query", "key": "prerender" }],
      "dest": "https://mealscout.onrender.com/$1?prerender=1"
    },
    {
      "src": "/",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": {
            "re": ".*(bot|Bot|crawler|Crawler|spider|Spider|facebookexternalhit|Facebot|whatsapp|WhatsApp|telegrambot|TelegramBot|slackbot|Slackbot|discordbot|Discordbot|linkedinbot|LinkedInBot|twitterbot|Twitterbot|applebot|Applebot|gptbot|GPTBot|claudebot|ClaudeBot|perplexitybot|PerplexityBot|bytespider|Bytespider|ccbot|CCBot).*"
          }
        }
      ],
      "dest": "https://mealscout.onrender.com/"
    },
    {
      "src": "/(map|search|video|share-hub|truck-onboarding|restaurant-signup|events|request-truck|for-restaurants|for-hosts|host-location-partner)",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": {
            "re": ".*(bot|Bot|crawler|Crawler|spider|Spider|facebookexternalhit|Facebot|whatsapp|WhatsApp|telegrambot|TelegramBot|slackbot|Slackbot|discordbot|Discordbot|linkedinbot|LinkedInBot|twitterbot|Twitterbot|applebot|Applebot|gptbot|GPTBot|claudebot|ClaudeBot|perplexitybot|PerplexityBot|bytespider|Bytespider|ccbot|CCBot).*"
          }
        }
      ],
      "dest": "https://mealscout.onrender.com/$1"
    },
    {
      "src": "/sitemap(.*)\\.xml",
      "dest": "https://mealscout.onrender.com/sitemap$1.xml"
    },
    {
      "src": "/robots.txt",
      "dest": "https://mealscout.onrender.com/robots.txt"
    },
    {
      "src": "/llms\\.txt",
      "dest": "https://mealscout.onrender.com/llms.txt"
    },
    {
      "src": "/ai\\.txt",
      "dest": "https://mealscout.onrender.com/ai.txt"
    },
    {
      "src": "/opensearch\\.xml",
      "dest": "https://mealscout.onrender.com/opensearch.xml"
    },
    {
      "src": "/\\.well-known/llms\\.txt",
      "dest": "https://mealscout.onrender.com/.well-known/llms.txt"
    },
    {
      "src": "/\\.well-known/ai\\.txt",
      "dest": "https://mealscout.onrender.com/.well-known/ai.txt"
    },
    {
      "src": "/\\.well-known/opensearch\\.xml",
      "dest": "https://mealscout.onrender.com/.well-known/opensearch.xml"
    },
    {
      "src": "/api/(.*)",
      "dest": "https://mealscout.onrender.com/api/$1"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/assets/(.*)",
      "status": 404
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        },
        {
          "key": "Pragma",
          "value": "no-cache"
        },
        {
          "key": "Expires",
          "value": "0"
        }
      ]
    },
    {
      "source": "/manifest.json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    }
  ]
}
