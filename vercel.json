{
  "installCommand": "npm ci",
  "buildCommand": "npm run build:client",
  "outputDirectory": "client/dist",
  "redirects": [
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "mealscout.us" }],
      "destination": "https://www.mealscout.us/$1",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/assets/:path*",
      "destination": "/assets/:path*"
    },
    {
      "source": "/static/:path*",
      "destination": "/static/:path*"
    },
    {
      "source": "/sitemap.xml",
      "destination": "https://mealscout.onrender.com/sitemap.xml"
    },
    {
      "source": "/sitemap-:name.xml",
      "destination": "https://mealscout.onrender.com/sitemap-:name.xml"
    },
    {
      "source": "/llms.txt",
      "destination": "https://mealscout.onrender.com/llms.txt"
    },
    {
      "source": "/ai.txt",
      "destination": "https://mealscout.onrender.com/ai.txt"
    },
    {
      "source": "/:indexNowKey([A-Za-z0-9_-]{8,128}).txt",
      "destination": "https://mealscout.onrender.com/:indexNowKey.txt"
    },
    {
      "source": "/api/(.*)",
      "destination": "https://mealscout.onrender.com/api/$1"
    },
    {
      "source": "/:kind(restaurant|truck|bar|chef|location|event|events|deal|supplier|suppliers|p|video)/:path*",
      "destination": "https://mealscout.onrender.com/:kind/:path*"
    },
    {
      "source": "/admin",
      "destination": "https://mealscout.onrender.com/admin"
    },
    {
      "source": "/admin/:path*",
      "destination": "https://mealscout.onrender.com/admin/:path*"
    },
    {
      "source": "/dashboard",
      "destination": "https://mealscout.onrender.com/dashboard"
    },
    {
      "source": "/dashboard/:path*",
      "destination": "https://mealscout.onrender.com/dashboard/:path*"
    },
    {
      "source": "/vendor-dashboard",
      "destination": "https://mealscout.onrender.com/vendor-dashboard"
    },
    {
      "source": "/vendor-dashboard/:path*",
      "destination": "https://mealscout.onrender.com/vendor-dashboard/:path*"
    },
    {
      "source": "/supplier-portal",
      "destination": "https://mealscout.onrender.com/supplier-portal"
    },
    {
      "source": "/supplier-portal/:path*",
      "destination": "https://mealscout.onrender.com/supplier-portal/:path*"
    },
    {
      "source": "/:path((?!assets/|static/).*)",
      "destination": "/index.html"
    }
  ],
  "routes": [
    {
      "src": "/sitemap.xml",
      "dest": "https://mealscout.onrender.com/sitemap.xml"
    },
    {
      "src": "/sitemap-([\\w-]+)\\.xml",
      "dest": "https://mealscout.onrender.com/sitemap-$1.xml"
    },
    {
      "src": "/robots.txt",
      "dest": "https://mealscout.onrender.com/robots.txt"
    },
    {
      "src": "/llms.txt",
      "dest": "https://mealscout.onrender.com/llms.txt"
    },
    {
      "src": "/ai.txt",
      "dest": "https://mealscout.onrender.com/ai.txt"
    },
    {
      "src": "/([A-Za-z0-9_-]{8,128})\\.txt",
      "dest": "https://mealscout.onrender.com/$1.txt"
    },
    {
      "src": "/assets/(.*\\.(?:js|css))",
      "headers": {
        "cache-control": "public, max-age=31536000, immutable"
      },
      "continue": true
    },
    {
      "src": "/static/(.*\\.(?:js|css))",
      "headers": {
        "cache-control": "public, max-age=31536000, immutable"
      },
      "continue": true
    },
    {
      "src": "/api/(.*)",
      "dest": "https://mealscout.onrender.com/api/$1"
    },
    {
      "src": "/(restaurant|truck|bar|chef|location|event|events|deal|supplier|suppliers|p|video)/(.*)",
      "dest": "https://mealscout.onrender.com/$1/$2"
    },
    {
      "src": "/admin(/.*)?",
      "dest": "https://mealscout.onrender.com/admin$1"
    },
    {
      "src": "/dashboard(/.*)?",
      "dest": "https://mealscout.onrender.com/dashboard$1"
    },
    {
      "src": "/vendor-dashboard(/.*)?",
      "dest": "https://mealscout.onrender.com/vendor-dashboard$1"
    },
    {
      "src": "/supplier-portal(/.*)?",
      "dest": "https://mealscout.onrender.com/supplier-portal$1"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/assets/(.*\\.(?:js|css))",
      "status": 404
    },
    {
      "src": "/static/(.*\\.(?:js|css))",
      "status": 404
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}

